@{
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
	<div class="row">
		<div class="col-12 mb-3">
			<div class="d-flex justify-content-between align-items-center">
				<h2 class="mb-0">Painel de Ações</h2>
				<div class="input-group w-50" style="max-width:560px;">
					<input id="tickerInput" type="text" class="form-control" placeholder="Pesquisar ticker (ex: AAPL, MSFT, PETR4.SA)" />
					<button id="loadBtn" class="btn btn-primary">Carregar</button>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-lg-3 mb-3">
			<div class="card shadow-sm">
				<div class="card-body">
					<h5 class="card-title">Tickers Rápidos</h5>
					<div class="d-flex flex-wrap gap-2">
						<button class="btn btn-outline-secondary quick-ticker">AAPL</button>
						<button class="btn btn-outline-secondary quick-ticker">MSFT</button>
						<button class="btn btn-outline-secondary quick-ticker">GOOGL</button>
						<button class="btn btn-outline-secondary quick-ticker">AMZN</button>
						<button class="btn btn-outline-secondary quick-ticker">PETR4.SA</button>
						<button class="btn btn-outline-secondary quick-ticker">VALE3.SA</button>
					</div>

					<hr />
					<h6>Intervalo</h6>
					<div class="btn-group" role="group">
						<button class="btn btn-sm btn-outline-primary range-btn" data-range="1m">1M</button>
						<button class="btn btn-sm btn-outline-primary range-btn" data-range="3m">3M</button>
						<button class="btn btn-sm btn-outline-primary range-btn" data-range="6m">6M</button>
						<button class="btn btn-sm btn-outline-primary range-btn active" data-range="1y">1Y</button>
						<button class="btn btn-sm btn-outline-primary range-btn" data-range="2y">2Y</button>
					</div>

					<div class="mt-3 text-muted small">Dica: use o campo de pesquisa para carregar qualquer ticker suportado pela API.</div>
				</div>
			</div>
		</div>

		<div class="col-lg-9">
			<div class="card shadow-sm">
				<div class="card-body">
					<div class="d-flex justify-content-between mb-2">
						<div>
							<h4 id="chartTitle" class="mb-0">Gráfico</h4>
							<small id="subTitle" class="text-muted">Selecione um ticker ou pesquise</small>
						</div>
						<div id="loading" class="text-muted" style="display:none">Carregando...</div>
					</div>

					<div id="chartWrapper" style="height:560px; min-width:310px"></div>
				</div>
			</div>
		</div>
	</div>
</div>

<script src="https://code.highcharts.com/stock/highstock.js"></script>
<script src="~/scripts/chart.js"></script>

<script>
	(function(){
		const candlesUrl = '@Url.Action("candles", "TickerBoard")';
		let chart = null;

		function setLoading(on){
			document.getElementById('loading').style.display = on ? 'inline' : 'none';
		}

		function toNumber(val){ return (val === null || val === undefined) ? 0 : Number(val); }

		async function loadCandles(ticker){
			if(!ticker) return;
			setLoading(true);
			document.getElementById('chartTitle').textContent = ticker.toUpperCase();
			document.getElementById('subTitle').textContent = 'Dados históricos';

			try{
				const res = await fetch(candlesUrl + '?ticker=' + encodeURIComponent(ticker));
				if(!res.ok) throw new Error('Falha ao carregar dados');
				const data = await res.json();

				// Transform to OHLC arrays expected by Highcharts
				const ohlc = data.map(d => [d.time, toNumber(d.open), toNumber(d.high), toNumber(d.low), toNumber(d.close)]);

				if(!chart){
					chart = Highcharts.stockChart('chartWrapper', {
						rangeSelector: { selected: 1 },
						title: { text: ticker.toUpperCase() },
						series: [{ type: 'candlestick', name: ticker.toUpperCase(), data: ohlc, tooltip: { valueDecimals: 2 } }],
						tooltip: { split: false, shared: true }
					});
				} else {
					chart.update({ title: { text: ticker.toUpperCase() } });
					const series = chart.series[0];
					series.setData(ohlc, true, { duration: 300 });
				}

			}catch(err){
				console.error(err);
				alert('Erro ao carregar dados: ' + err.message);
			}finally{
				setLoading(false);
			}
		}

		// Wire UI
		document.getElementById('loadBtn').addEventListener('click', ()=>{
			const t = document.getElementById('tickerInput').value.trim();
			if(t) loadCandles(t);
		});

		document.querySelectorAll('.quick-ticker').forEach(b=> b.addEventListener('click', e=>{
			const t = e.target.textContent.trim();
			document.getElementById('tickerInput').value = t;
			loadCandles(t);
		}));

		document.querySelectorAll('.range-btn').forEach(b=> b.addEventListener('click', e=>{
			document.querySelectorAll('.range-btn').forEach(x=> x.classList.remove('active'));
			e.target.classList.add('active');
			// for now range selection is cosmetic; API currently fetches 2y by default
		}));

		// Optionally load default ticker
		// loadCandles('AAPL');
	})();
</script>